{
  "description": "Daybook hooks for automatic session archiving and multi-agent worktree coordination",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "daybook hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|replace|replace_match|insert",
        "hooks": [
          {
            "type": "command",
            "command": "daybook hook pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|replace|replace_match|insert",
        "hooks": [
          {
            "type": "command",
            "command": "daybook hook post-tool-use"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "daybook hook session-end"
          }
        ]
      }
    ]
  }
}
